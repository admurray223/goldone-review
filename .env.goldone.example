# GoldOne Environment Configuration Example
# Copy this file to .env.goldone and fill in your values
# DO NOT commit .env.goldone to git

# Hithink Finance API Key
# Get from https://fuyao.aicubes.cn/admin
HITHINK_FINANCE_API_KEY=

# Optional: Local DuckDB path (defaults to project data/goldone.duckdb)
# GOLDONE_DB_PATH=data/goldone.duckdb

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# LOG_LEVEL=INFO